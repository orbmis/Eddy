{
  "name": "eddy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
