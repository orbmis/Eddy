# Copy to .env (gitignored). NEVER commit the filled-in version.

# --- Network ---
BASE_RPC_URL=
ARBITRUM_RPC_URL=
CHAIN=base                      # base | arbitrum

# --- Wallet ---
SAFE_ADDRESS=
# Agent signer. USE A THROWAWAY TESTNET KEY ONLY for dev.
# Production must use a SCOPED SESSION KEY / Safe module, NOT a raw EOA key.
AGENT_PRIVATE_KEY=

# --- CoW ---
COW_API_URL=                    # network-specific orderbook endpoint

# --- Yield venue (Aave v3) ---
# Addresses are sourced from src/config/addresses.ts (Base mainnet); these are
# optional overrides only.
AAVE_POOL_ADDRESS=
USDC_ADDRESS=
AUSDC_ADDRESS=

# --- Envelope (caveat bounds; defaults live in src/config/envelope.ts) ---
MAX_SPEND_PER_EPOCH_USDC=100    # hard per-epoch cap (human USDC)
DEPOSIT_USDC=50                 # idle USDC supplied to Aave (M1); kept below the cap
MAX_SLIPPAGE_BPS=200            # → per-part TWAP limit price (2%)
MAX_ORDER_TTL_SECONDS=604800    # max order lifetime (expiry = t0 + n*t must be ≤ now + this); 7d
ALLOWED_BUY_TOKENS=             # comma-separated; basket only (defaults to WETH)
USDC_BUFFER=10                  # shock absorber for yield-venue withdrawal liquidity

# --- Fork (M0/M1 deterministic gate) ---
FORK_BLOCK=47300000             # pinned Base mainnet block for reproducible fork tests

# --- Mode ---
DRY_RUN=true                    # true = simulate/sign only, never broadcast real value
