# Copy to .env (gitignored). NEVER commit the filled-in version.

# --- Network ---
BASE_RPC_URL=
ARBITRUM_RPC_URL=
CHAIN=base                      # base | arbitrum

# --- Wallet ---
SAFE_ADDRESS=
# Agent signer. USE A THROWAWAY TESTNET KEY ONLY for dev.
# Production must use a SCOPED SESSION KEY / Safe module, NOT a raw EOA key.
AGENT_PRIVATE_KEY=

# --- CoW ---
COW_API_URL=                    # network-specific orderbook endpoint

# --- Yield venue (Aave v3) ---
AAVE_POOL_ADDRESS=
USDC_ADDRESS=
AUSDC_ADDRESS=

# --- Envelope (caveat bounds; can also live in src/config) ---
MAX_SPEND_PER_EPOCH_USDC=       # hard per-epoch cap
MAX_SLIPPAGE_BPS=               # → per-part TWAP limit price
ALLOWED_BUY_TOKENS=             # comma-separated; basket only
USDC_BUFFER=                    # shock absorber for yield-venue withdrawal liquidity

# --- Mode ---
DRY_RUN=true                    # true = simulate/sign only, never broadcast real value
